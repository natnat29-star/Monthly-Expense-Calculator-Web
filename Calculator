<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Monthly Expense Calculator</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <h1>Monthly Expense Calculator</h1>

    <div class="container">
    
        <div class="left-section">
            <h3>Income and Expenses</h3>

            <div class="income-expense">
                <label for="Income1">Total Income: </label>
                <input type="text" id="Income1" readonly> <br>

                <label for="Expense">Total Expenses: </label>
                <input type="text" id="Expense" readonly> <br>

                <label for="Balance">Total Balance: </label>
                <input type="text" id="Balance" readonly>
            </div>

            <h3>Add Transaction</h3>
            <div class="transaction-form">
                <label for="name">Name:</label>
                <input type="text" id="name">

                <label for="category">Category:</label>
                <input type="text" id="category">

                <label>Type:</label>
                <label for="income">Income</label>
                <input type="radio" id="income" name="type" value="Income">
                <label for="expense">Expense</label>
                <input type="radio" id="expense" name="type" value="Expense">

                <label for="amount">Amount:</label>
                <input type="text" id="amount">

                <button type="button" onclick="addTransaction()">Submit</button>
            </div>
        </div>

        <div class="right-section">
            <h3>Transaction List:</h3>
            <table id="transactionTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                  
                </tbody>
            </table>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
